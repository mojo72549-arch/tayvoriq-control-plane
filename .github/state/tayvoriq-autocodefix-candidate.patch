+def _verified_overlay_proof(
+    request: dict[str, Any],
+    manifest: dict[str, Any] | None,
+) -> tuple[bool, list[str]]:
+    manifest = manifest if isinstance(manifest, dict) else {}
+    recovery = request.get("codefix_recovery")
+    recovery = recovery if isinstance(recovery, dict) else {}
+    issues: list[str] = []
+
+    request_id = _clean(request.get("request_id"))
+    patch_sha = _clean(recovery.get("verified_overlay_patch_sha256")).casefold()
+    manifest_patch_sha = _clean(manifest.get("autocodefix_patch_sha256")).casefold()
+    replay_impl_sha = _clean(recovery.get("replay_implementation_sha")).casefold()
+    manifest_impl_sha = _clean(manifest.get("implementation_sha")).casefold()
+    replay_run_id = str(recovery.get("replay_run_id") or "").strip()
+    manifest_run_id = str(manifest.get("run_id") or "").strip()
+
+    if recovery.get("status") != "REPLAY_DISPATCHED":
+        issues.append("overlay_recovery_status_not_replay_dispatched")
+    if recovery.get("request_substate") != "DISPATCHED":
+        issues.append("overlay_request_substate_not_dispatched")
+    if not re.fullmatch(r"[0-9a-f]{64}", patch_sha):
+        issues.append("overlay_patch_sha_invalid")
+    if manifest.get("autocodefix_overlay_applied") is not True:
+        issues.append("overlay_manifest_not_applied")
+    if manifest_patch_sha != patch_sha:
+        issues.append("overlay_patch_sha_mismatch")
+    if manifest.get("implementation_binding") != "production-green-sha+verified-request-codefix-overlay":
+        issues.append("overlay_implementation_binding_invalid")
+    if _clean(manifest.get("source_request_id")) != request_id:
+        issues.append("overlay_request_binding_mismatch")
+    if manifest.get("quality_gates_weakened") is not False:
+        issues.append("overlay_quality_gate_integrity_failed")
+    if replay_impl_sha and manifest_impl_sha != replay_impl_sha:
+        issues.append("overlay_implementation_sha_mismatch")
+    if replay_run_id and manifest_run_id != replay_run_id:
+        issues.append("overlay_replay_run_mismatch")
+
+    return not issues, issues
+
