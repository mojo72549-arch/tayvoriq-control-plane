{
  "schema_version": "v1",
  "production_progress_enabled": true,
  "mode": "verified_percentage_milestones_with_silent_internal_recovery",
  "notify_only_on_real_state_change": true,
  "suppress_same_run_retries": true,
  "same_run_replay_suppressed_stages": [
    "sources_locked",
    "production_active"
  ],
  "heartbeat_interval_seconds": 180,
  "heartbeat_reports_elapsed_time_without_fake_progress": true,
  "immediate_failure_notification_enabled": false,
  "internal_recovery_operator_noise_suppressed": true,
  "terminal_external_blocker_notification_enabled": true,
  "enabled_until_user_opt_out": true,
  "milestones": [
    "sources_locked",
    "production_active",
    "render_heartbeat",
    "checkpoint_repair",
    "checkpoint_heartbeat",
    "master_ready",
    "quality_passed",
    "review_ready"
  ],
  "checkpoint_repair_heartbeat_interval_seconds": 180
}
