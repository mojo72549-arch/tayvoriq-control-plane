{
  "schema_version": "v2",
  "production_progress_enabled": true,
  "mode": "verified_state_changes_with_silent_watchdog_polling",
  "notify_only_on_real_state_change": true,
  "suppress_same_run_retries": true,
  "same_run_replay_suppressed_stages": [
    "sources_locked"
  ],
  "watchdog_poll_interval_seconds": 180,
  "operator_heartbeat_notify_minutes": [18, 45],
  "heartbeat_reports_elapsed_time_without_fake_progress": true,
  "suppress_intermediate_liveness_polls": true,
  "immediate_failure_notification_enabled": true,
  "internal_recovery_operator_noise_suppressed": true,
  "terminal_external_blocker_notification_enabled": true,
  "enabled_until_user_opt_out": true,
  "milestones": [
    "sources_locked",
    "production_active",
    "checkpoint_repair",
    "master_ready",
    "quality_passed",
    "review_ready"
  ],
  "long_running_threshold_stages": [
    "render_heartbeat",
    "checkpoint_heartbeat"
  ]
}
