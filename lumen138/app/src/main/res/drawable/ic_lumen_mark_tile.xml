<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FF57B7F2"
                android:centerColor="#FF3B82F6"
                android:endColor="#FF6D4CE8" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#8062E7D3" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_lumen_mark_glyph"
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp" />
</layer-list>
