<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#06101D"
                android:centerColor="#092233"
                android:endColor="#124A5D" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="rectangle">
            <size android:width="250dp" android:height="72dp" />
            <solid android:color="#17354A" />
            <stroke android:width="2dp" android:color="#5EEAD4" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
